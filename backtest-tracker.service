[Unit]
Description=Undercurrent backtest tracker (one-shot, run daily by backtest-tracker.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=connor
WorkingDirectory=/home/connor/undercurrent-scanner
EnvironmentFile=/home/connor/undercurrent-scanner/scanner.env
ExecStart=/usr/bin/python3 /home/connor/undercurrent-scanner/backtest_tracker.py
StandardOutput=append:/home/connor/undercurrent-scanner/backtest.log
StandardError=append:/home/connor/undercurrent-scanner/backtest.log
