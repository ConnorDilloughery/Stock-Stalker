[Unit]
Description=Undercurrent market scanner (continuous rolling scans)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=connor
WorkingDirectory=/home/connor/undercurrent-scanner
EnvironmentFile=/home/connor/undercurrent-scanner/scanner.env
ExecStart=/usr/bin/python3 /home/connor/undercurrent-scanner/market_scanner.py
Restart=always
RestartSec=30
StandardOutput=append:/home/connor/undercurrent-scanner/scanner.log
StandardError=append:/home/connor/undercurrent-scanner/scanner.log

[Install]
WantedBy=multi-user.target
