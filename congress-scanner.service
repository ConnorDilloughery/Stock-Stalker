[Unit]
Description=Undercurrent congressional trading scanner (one-shot, run daily by congress-scanner.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=connor
WorkingDirectory=/home/connor/undercurrent-scanner
EnvironmentFile=/home/connor/undercurrent-scanner/scanner.env
ExecStart=/usr/bin/python3 /home/connor/undercurrent-scanner/congress_scanner.py
StandardOutput=append:/home/connor/undercurrent-scanner/congress.log
StandardError=append:/home/connor/undercurrent-scanner/congress.log
